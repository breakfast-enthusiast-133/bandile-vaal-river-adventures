{
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    { "src": "/(includes|data)(/.*)?", "status": 404 },
    { "src": "/", "dest": "/api/index.php?page=index" },
    { "src": "/(index|about|tours|gallery|contact)\\.php", "dest": "/api/index.php?page=$1" },
    { "handle": "filesystem" }
  ]
}
